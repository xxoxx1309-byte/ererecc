{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      ".gitignore",
      ".firebaserc",
      ".git/**",
      ".firebase/**",
      "supabase/**",
      "firebase-debug.log",
      "firebase-home.png",
      "reference-scoreboard.png",
      "*.log",
      "**/node_modules/**",
      "test-results/**",
      "functions/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
