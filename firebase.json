{
  "hosting": {
    "public": ".",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "README.md",
      ".gitignore",
      ".firebaserc",
      ".git/**",
      ".firebase/**",
      "supabase/**",
      "firebase-debug.log",
      "firebase-home.png",
      "reference-scoreboard.png",
      "*.log",
      "**/node_modules/**",
      "test-results/**",
      "functions/**",
      "rank-proxy/**"
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default"
    }
  ]
}
