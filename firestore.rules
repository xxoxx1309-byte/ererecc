rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function email() {
      return request.auth.token.email;
    }

    function isOwner() {
      return signedIn() && email() == "xxoxx1309@gmail.com";
    }

    function isOperator() {
      return signedIn() && (
        isOwner() ||
        exists(/databases/$(database)/documents/siteOperators/$(email()))
      );
    }

    function eventOpen(eventId) {
      return get(/databases/$(database)/documents/events/$(eventId)).data.registration_open != false;
    }

    function ownsEvent(eventId) {
      let event = get(/databases/$(database)/documents/events/$(eventId)).data;
      return isOperator() || (signedIn() && (
        event.owner_id == request.auth.uid
        || (event.owner_email != null && event.owner_email == email())
      ));
    }

    match /siteOperators/{operatorEmail} {
      allow read: if isOperator() || (signedIn() && email() == operatorEmail);
      allow create, update: if isOwner()
        && request.resource.data.email == operatorEmail
        && request.resource.data.is_owner == false;
      allow delete: if isOwner();
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.owner_id == request.auth.uid
        && (request.resource.data.owner_email == "" || request.resource.data.owner_email == email());
      allow update, delete: if isOperator() || (signedIn() && (
        resource.data.owner_id == request.auth.uid
        || (resource.data.owner_email != null && resource.data.owner_email == email())
      ));

      match /applicants/{applicantId} {
        allow read, update, delete: if ownsEvent(eventId);
        allow read: if get(/databases/$(database)/documents/events/$(eventId)).data.published == true;
        allow create: if eventOpen(eventId);
      }

      match /backups/{backupId} {
        allow read, create, update, delete: if ownsEvent(eventId);
      }
    }
  }
}
